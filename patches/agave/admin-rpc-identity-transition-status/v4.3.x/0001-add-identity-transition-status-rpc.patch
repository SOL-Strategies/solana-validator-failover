diff --git a/votor-messages/src/identity_transition_status.rs b/votor-messages/src/identity_transition_status.rs
new file mode 100644
index 0000000..00610c8
--- /dev/null
+++ b/votor-messages/src/identity_transition_status.rs
@@ -0,0 +1,96 @@
+//! Process-local identity transition state shared by validator services.
+#![allow(missing_docs)]
+
+use {
+    serde::{Deserialize, Serialize},
+    solana_clock::Slot,
+    solana_pubkey::Pubkey,
+    std::sync::{LazyLock, RwLock},
+};
+
+#[derive(Clone, Debug, Deserialize, Serialize)]
+#[serde(rename_all = "camelCase")]
+pub struct IdentityTransitionStatus {
+    pub version: u64,
+    pub sequence: u64,
+    pub state: String,
+    pub consensus: String,
+    pub current_identity: String,
+    pub from_identity: String,
+    pub to_identity: String,
+    pub vote_account: String,
+    pub last_vote_slot: Option<Slot>,
+    pub tower_root_slot: Option<Slot>,
+    pub error: Option<String>,
+}
+
+static STATUS: LazyLock<RwLock<Option<IdentityTransitionStatus>>> =
+    LazyLock::new(|| RwLock::new(None));
+
+pub fn begin(from_identity: Pubkey, to_identity: Pubkey, vote_account: Pubkey) -> u64 {
+    let mut status = STATUS.write().unwrap();
+    let sequence = status.as_ref().map_or(1, |previous| previous.sequence + 1);
+    *status = Some(IdentityTransitionStatus {
+        version: 1,
+        sequence,
+        state: "transitioning".to_string(),
+        consensus: "pending".to_string(),
+        current_identity: from_identity.to_string(),
+        from_identity: from_identity.to_string(),
+        to_identity: to_identity.to_string(),
+        vote_account: vote_account.to_string(),
+        last_vote_slot: None,
+        tower_root_slot: None,
+        error: None,
+    });
+    sequence
+}
+
+pub fn complete(
+    from_identity: Pubkey,
+    to_identity: Pubkey,
+    consensus: &str,
+    last_vote_slot: Option<Slot>,
+    root_slot: Slot,
+) {
+    if let Some(status) = STATUS.write().unwrap().as_mut()
+        && status.state == "transitioning"
+        && status.from_identity == from_identity.to_string()
+        && status.to_identity == to_identity.to_string()
+    {
+        status.state = "complete".to_string();
+        status.consensus = consensus.to_string();
+        status.current_identity = to_identity.to_string();
+        status.last_vote_slot = last_vote_slot;
+        status.tower_root_slot = Some(root_slot);
+    }
+}
+
+pub fn fail(sequence: u64, error: impl Into<String>) {
+    if let Some(status) = STATUS.write().unwrap().as_mut()
+        && status.sequence == sequence
+    {
+        status.state = "failed".to_string();
+        status.error = Some(error.into());
+    }
+}
+
+pub fn get(current_identity: Pubkey) -> IdentityTransitionStatus {
+    STATUS
+        .read()
+        .unwrap()
+        .clone()
+        .unwrap_or_else(|| IdentityTransitionStatus {
+            version: 1,
+            sequence: 0,
+            state: "idle".to_string(),
+            consensus: "unknown".to_string(),
+            current_identity: current_identity.to_string(),
+            from_identity: current_identity.to_string(),
+            to_identity: current_identity.to_string(),
+            vote_account: String::new(),
+            last_vote_slot: None,
+            tower_root_slot: None,
+            error: None,
+        })
+}
