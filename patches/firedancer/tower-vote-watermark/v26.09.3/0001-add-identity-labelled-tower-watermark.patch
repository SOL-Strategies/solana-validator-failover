index b4bfacf..93edae6 100644
--- a/src/disco/metrics/fd_prometheus.c
+++ b/src/disco/metrics/fd_prometheus.c
@@ -1,9 +1,11 @@
 #include "fd_prometheus.h"
 
 #include "fd_metrics.h"
+#include "generated/fd_metrics_tower.h"
 
 #include "../topo/fd_topo.h"
 #include "../../waltz/http/fd_http_server.h"
+#include "../../ballet/base58/fd_base58.h"
 
 struct fd_prom_render {
   fd_http_server_t * http;
@@ -169,12 +171,49 @@ render_links_in( fd_prom_render_t *        r,
   }
 }
 
+static void
+render_tower_vote_slot_by_identity( fd_prom_render_t *        r,
+                                    fd_topo_tile_t const *    tile ) {
+  volatile ulong * metrics = fd_metrics_tile( tile->metrics );
+  uchar current_identity[ 32UL ];
+  uchar previous_identity[ 32UL ];
+  for( ulong i=0UL; i<4UL; i++ ) {
+    ((ulong *)current_identity)[ i ] = metrics[ FD_METRICS_GAUGE_TOWER_CURRENT_IDENTITY_KEY0_OFF + i ];
+    ((ulong *)previous_identity)[ i ] = metrics[ FD_METRICS_GAUGE_TOWER_PREVIOUS_IDENTITY_KEY0_OFF + i ];
+  }
+
+  char current_identity_b58[ FD_BASE58_ENCODED_32_SZ ];
+  char previous_identity_b58[ FD_BASE58_ENCODED_32_SZ ];
+  fd_base58_encode_32( current_identity, NULL, current_identity_b58 );
+  fd_base58_encode_32( previous_identity, NULL, previous_identity_b58 );
+  ulong current_vote_slot = *(metrics + FD_METRICS_GAUGE_TOWER_CURRENT_IDENTITY_VOTE_SLOT_OFF);
+  ulong previous_vote_slot = *(metrics + FD_METRICS_GAUGE_TOWER_PREVIOUS_IDENTITY_VOTE_SLOT_OFF);
+
+  fd_http_server_printf( r->http, "# HELP tower_vote_slot_by_identity Highest voted slot in the local tower, labelled by the identity that voted it\n# TYPE tower_vote_slot_by_identity gauge\n" );
+  if( current_vote_slot!=ULONG_MAX ) {
+    fd_http_server_printf( r->http, "tower_vote_slot_by_identity{kind=\"%s\",kind_id=\"%lu\",identity=\"%s\"} %lu\n", tile->name, tile->kind_id, current_identity_b58, current_vote_slot );
+  }
+  if( previous_vote_slot!=ULONG_MAX && memcmp( previous_identity, (uchar[32UL]){0}, 32UL ) ) {
+    fd_http_server_printf( r->http, "tower_vote_slot_by_identity{kind=\"%s\",kind_id=\"%lu\",identity=\"%s\"} %lu\n", tile->name, tile->kind_id, previous_identity_b58, previous_vote_slot );
+  }
+}
+
+static int
+is_tower_identity_metadata( fd_metrics_meta_t const * metric ) {
+  return !strncmp( metric->name, "tower_current_identity_key", 26UL ) ||
+         !strcmp( metric->name, "tower_current_identity_vote_slot" ) ||
+         !strncmp( metric->name, "tower_previous_identity_key", 27UL ) ||
+         !strcmp( metric->name, "tower_previous_identity_vote_slot" );
+}
+
 static void
 render_tile_metric( fd_prom_render_t *        r,
                     fd_topo_tile_t const *    tile,
                     fd_metrics_meta_t const * metric ) {
+  if( FD_UNLIKELY( is_tower_identity_metadata( metric ) ) ) return;
   if( FD_LIKELY( metric->type==FD_METRICS_TYPE_COUNTER || metric->type==FD_METRICS_TYPE_GAUGE ) ) {
     render_counter( r, metric, tile );
+    if( FD_UNLIKELY( !strcmp( tile->name, "tower" ) && !strcmp( metric->name, "tower_vote_slot" ) ) ) render_tower_vote_slot_by_identity( r, tile );
   } else if( FD_LIKELY( metric->type==FD_METRICS_TYPE_HISTOGRAM ) ) {
     render_histogram( r, metric, tile );
   }
